# Copy to .env.local and fill in your own values. Never commit real keys.

# Supabase (https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by /api/deals/* routes for writes
SUPABASE_SERVICE_ROLE_KEY=

# Amadeus flight search (optional; https://developers.amadeus.com)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Set to "true" to use the production Amadeus API instead of the test API
AMADEUS_PRODUCTION=
